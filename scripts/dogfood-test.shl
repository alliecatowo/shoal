execute("artifact-inventory.shl", [source, artifact_inventory_after])
let artifact_diff = root.join("artifact-diff.json")
execute("artifact-diff.shl", [artifact_inventory, artifact_inventory_after, artifact_diff])
assert(json.parse(artifact_diff.read).added.len() == 1, "artifact diff missed an added file")

let backup_catalog = root.join("backup-catalog.json")
execute("backup-catalog.shl", [root, backup_catalog])
assert(json.parse(backup_catalog.read).count == 1, "backup catalog missed the created backup")

