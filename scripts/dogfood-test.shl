execute("log-redact.shl", [sensitive_logs, redaction_values, redacted_logs])
assert(json.parse(redacted_logs.read).records.first().message == "request used token-[REDACTED]", "log redaction retained protected text")

let maintenance_tasks = root.join("maintenance-tasks.json")
json.stringify([
  {name: "database", minutes: 30, priority: 10},
  {name: "cache", minutes: 15, priority: 5},
