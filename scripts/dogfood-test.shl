execute("retry-plan.shl", [task_failures, "3", retry_plan])
let retries = json.parse(retry_plan.read)
assert(retries.retry.len() == 1 && retries.exhausted == ["publish"] && retries.terminal == ["compile"], "retry plan classification is wrong")

let deployment_history = root.join("deployment-history.json")
json.stringify([
  {sequence: 1, host: "staging-1", previous_version: "0.1.0", status: "completed"},
  {sequence: 2, host: "production-1", previous_version: "0.1.0", status: "completed"},
], pretty: true).save(deployment_history)
let rollback_plan = root.join("rollback-plan.json")
execute("rollback-plan.shl", [deployment_history, rollback_plan])
assert(json.parse(rollback_plan.read).steps.first().host == "production-1", "rollback plan is not reverse ordered")

let credentials = root.join("credentials.json")
json.stringify([
  {name: "registry", age_days: 100, compromised: false},
  {name: "deploy", age_days: 2, compromised: true},
  {name: "monitor", age_days: 5, compromised: false},
], pretty: true).save(credentials)
let rotation_plan = root.join("rotation-plan.json")
execute("secret-rotation-plan.shl", [credentials, "90", rotation_plan])
assert(json.parse(rotation_plan.read).rotate.len() == 2, "secret rotation plan omitted due credentials")

let probes = root.join("service-probes.json")
json.stringify([
  {service: "kernel", component: "rpc", status: "ok"},
  {service: "kernel", component: "journal", status: "degraded"},
  {service: "site", component: "http", status: "ok"},
], pretty: true).save(probes)
let health_report = root.join("service-health.json")
execute("service-health-summary.shl", [probes, health_report])
assert(json.parse(health_report.read).unhealthy == ["kernel"], "service health summary missed degradation")

let test_results = root.join("test-results.json")
json.stringify([
  {name: "parser-a", owner: "language", status: "failed", signature: "parse-eof"},
  {name: "parser-b", owner: "language", status: "failed", signature: "parse-eof"},
  {name: "kernel-a", owner: "runtime", status: "passed", signature: ""},
], pretty: true).save(test_results)
let triage_report = root.join("test-triage.json")
execute("test-failure-triage.shl", [test_results, triage_report])
assert(json.parse(triage_report.read).groups.first().count == 2, "test failure triage did not group signatures")

# A complete continuity drill invokes six cooperating operational programs,
# persists intermediate evidence, restores into a fresh tree, and verifies the
# round trip. Run it through the ordinary noninteractive CLI path without the
# redundant explicit `--standalone` selector.
let continuity_workspace = root.join("continuity-workspace")
let continuity_report = root.join("continuity-report.json")
execute_default_noninteractive("workspace-continuity.shl", [
  executable,
  programs,
  source,
  continuity_workspace,
  continuity_report,
])
let continuity = json.parse(continuity_report.read)
assert(continuity.recoverable, "workspace continuity drill did not certify recovery")
assert(continuity.phase_count == 8, "workspace continuity drill omitted an operational phase")
assert(continuity.integrity.source_equals_backup, "workspace continuity source and backup differ")
assert(continuity.integrity.backup_equals_restore, "workspace continuity backup and restore differ")
assert(continuity_workspace.join("restored/nested/new.txt").read == "new artifact\n", "continuity restore lost the newest workspace artifact")
assert(continuity_workspace.join("evidence/round-trip-diff.json").is_file, "continuity drill omitted its durable diff evidence")
let refused_continuity_replace = run(
  executable,
  programs.join("workspace-continuity.shl"),
  executable,
  programs,
  source,
  continuity_workspace,
  root.join("second-continuity-report.json"),
)
assert(!refused_continuity_replace.ok, "continuity drill replaced an existing evidence workspace")
assert(continuity_workspace.join("restored/nested/new.txt").read == "new artifact\n", "rejected continuity retry changed prior recovery evidence")

# Reconcile independently produced CI evidence into one release decision. The
# fixture includes an allowed artifact addition and a meaningful performance
# improvement, then proves that all required checks remain decisive.
let ci_tests = root.join("ci-evidence-tests.json")
json.stringify([
  {name: "parser::accepts_program", owner: "language", status: "passed", signature: "", duration_ms: 12},
  {name: "cli::default_noninteractive", owner: "runtime", status: "passed", signature: "", duration_ms: 31},
  {name: "ops::continuity", owner: "operations", status: "passed", signature: "", duration_ms: 48},
  {name: "site::links", owner: "documentation", status: "skipped", signature: "platform-exempt", duration_ms: 0},
], pretty: true).save(ci_tests)
let ci_checks = root.join("ci-evidence-checks.json")
json.stringify([
  {name: "format", required: true, status: "pass"},
  {name: "clippy", required: true, status: "pass"},
  {name: "workspace-tests", required: true, status: "pass"},
  {name: "macos-smoke", required: false, status: "pass"},
], pretty: true).save(ci_checks)
let ci_evidence_report = root.join("ci-evidence-report.json")
execute("ci-evidence-auditor.shl", [
  ci_tests,
  baseline,
  current,
  artifact_inventory,
  artifact_inventory_after,
  ci_checks,
  ci_evidence_report,
])
let ci_evidence = json.parse(ci_evidence_report.read)
assert(ci_evidence.ready, "passing CI evidence was classified as blocked")
assert(ci_evidence.tests.total == 4 && ci_evidence.tests.passed == 3, "CI evidence test accounting is wrong")
assert(ci_evidence.tests.owners.len() == 4, "CI evidence lost an owning team")
assert(ci_evidence.benchmarks.compared == 2, "CI evidence omitted benchmark comparisons")
assert(ci_evidence.benchmarks.regressions.is_empty(), "CI evidence invented a benchmark regression")
assert(ci_evidence.artifacts.added.len() == 1, "CI evidence missed the new artifact")
assert(ci_evidence.artifacts.removed.is_empty(), "CI evidence invented an artifact removal")
assert(ci_evidence.checks.required_passed.len() == 3, "CI evidence lost required check outcomes")
let blocked_ci_tests = root.join("blocked-ci-tests.json")
json.stringify([
  {name: "cli::default_noninteractive", owner: "runtime", status: "failed", signature: "execution-timeout", duration_ms: 75},
], pretty: true).save(blocked_ci_tests)
let blocked_ci_checks = root.join("blocked-ci-checks.json")
json.stringify([
  {name: "format", required: true, status: "pass"},
  {name: "workspace-tests", required: true, status: "pending"},
], pretty: true).save(blocked_ci_checks)
let blocked_ci_report = root.join("blocked-ci-report.json")
let blocked_ci_result = run(
  executable,
  "--standalone",
  programs.join("ci-evidence-auditor.shl"),
  blocked_ci_tests,
  baseline,
  current,
  artifact_inventory,
  artifact_inventory_after,
  blocked_ci_checks,
  blocked_ci_report,
)
assert(blocked_ci_result.ok, "CI auditor failed to persist an intentionally blocked decision: {blocked_ci_result.err}")
let blocked_ci = json.parse(blocked_ci_report.read)
assert(!blocked_ci.ready, "CI auditor accepted failing tests and a pending required check")
assert("test-failures" in blocked_ci.blockers && "required-checks-pending" in blocked_ci.blockers, "CI auditor omitted expected blockers")

# Assemble a command-center directory from heterogeneous incident evidence,
# with secret redaction, severity derivation, prioritized response work, and
# independently inspectable health/traffic/timeline artifacts.
let command_probes = root.join("command-center-probes.json")
json.stringify([
  {service: "kernel", component: "rpc", status: "down"},
  {service: "kernel", component: "journal", status: "degraded"},
  {service: "site", component: "http", status: "ok"},
], pretty: true).save(command_probes)
let command_access = root.join("command-center-access.json")
json.stringify([
  {route: "/health", status: 200, duration_ms: 2},
  {route: "/jobs", status: 503, duration_ms: 45},
  {route: "/jobs", status: 503, duration_ms: 51},
], pretty: true).save(command_access)
let command_events = root.join("command-center-events.json")
json.stringify([
  {timestamp_ns: 100, source: "monitor", kind: "alert", message: "kernel unavailable"},
  {timestamp_ns: 120, source: "operator", kind: "action", message: "isolated rpc listener"},
  {timestamp_ns: 145, source: "kernel", kind: "observation", message: "journal remained readable"},
], pretty: true).save(command_events)
let command_logs = root.join("command-center-logs.json")
json.stringify([
  {timestamp_ns: 101, level: "error", source: "kernel", message: "token incident-secret rejected"},
  {timestamp_ns: 121, level: "warn", source: "gateway", message: "rpc unavailable for tenant-red"},
  {timestamp_ns: 146, level: "info", source: "kernel", message: "journal probe complete"},
], pretty: true).save(command_logs)
let command_secrets = root.join("command-center-secrets.json")
json.stringify([{name: "token", value: "incident-secret"}], pretty: true).save(command_secrets)
let command_metadata = root.join("command-center-metadata.json")
json.stringify({id: "INC-9001", owner: "shell-team", started_at_ns: 100, objective: "restore private RPC without losing journal evidence"}, pretty: true).save(command_metadata)
let command_center = root.join("command-center")
execute("incident-command-center.shl", [
  command_probes,
  command_access,
  command_events,
  command_logs,
  command_secrets,
  command_metadata,
  command_center,
])
let command_summary = json.parse(command_center.join("summary.json").read)
let redacted_command_logs = command_center.join("evidence/redacted-logs.json").read
assert(command_summary.severity == "critical", "incident command center understated the fixture severity")
assert(!command_summary.recovered, "incident command center invented recovery evidence")
assert(command_summary.services.down == 1, "incident command center lost the down service")
assert(command_summary.traffic.server_errors == 2, "incident command center lost server errors")
assert(command_summary.response_actions.len() >= 4, "incident command center omitted response work")
assert(redacted_command_logs.contains("[REDACTED:token]"), "incident command center did not record its redaction")
assert(!redacted_command_logs.contains("incident-secret"), "incident command center leaked protected log content")
assert(command_center.join("action-plan.json").is_file, "incident command center omitted its durable action plan")
let unsafe_command_secrets = root.join("unsafe-command-center-secrets.json")
json.stringify([{name: "unsafe", value: "x"}], pretty: true).save(unsafe_command_secrets)
let rejected_command_center = run(
  executable,
  "--standalone",
  programs.join("incident-command-center.shl"),
  command_probes,
  command_access,
  command_events,
  command_logs,
  unsafe_command_secrets,
  command_metadata,
  root.join("unsafe-command-center"),
)
assert(!rejected_command_center.ok, "incident command center accepted a dangerously short redaction value")
assert(!root.join("unsafe-command-center").exists, "rejected incident command center published partial evidence")

let program_count = glob(programs.join("*.shl").display()).expand().len()
assert(program_count >= 50, "functional operations program count regressed: {program_count}")
let executed_program_count = executed_programs.uniq().len()
assert(executed_program_count == program_count, "dogfood runner executed {executed_program_count} distinct programs but ships {program_count}")
let fixture_removed = (rm --permanent --recursive (root))
echo "dogfood gate passed: {program_count} operational programs, {executed_programs.len()} asserted program invocations"
