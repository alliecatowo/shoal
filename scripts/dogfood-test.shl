execute("ownership-report.shl", [components, ownership_report])
assert(json.parse(ownership_report.read).unowned == ["legacy"], "ownership report missed an unowned component")

let resources = root.join("resources.json")
json.stringify([
  {name: "cas", used: 110, limit: 100, warn_percent: 80},
  {name: "journal", used: 85, limit: 100, warn_percent: 80},
  {name: "sessions", used: 2, limit: 10, warn_percent: 80},
], pretty: true).save(resources)
