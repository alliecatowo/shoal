let task_failures = root.join("task-failures.json")
json.stringify([
  {task: "fetch", code: "timeout", attempts: 1},
  {task: "publish", code: "rate_limited", attempts: 3},
  {task: "compile", code: "invalid_input", attempts: 1},
], pretty: true).save(task_failures)
