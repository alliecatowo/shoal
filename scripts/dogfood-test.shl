json.stringify({packages: [{name: "alpha", version: "1.0"}, {name: "gone", version: "1.0"}]}, pretty: true).save(dependencies_before)
json.stringify({packages: [{name: "alpha", version: "2.0"}, {name: "new", version: "1.0"}]}, pretty: true).save(dependencies_after)
let dependency_diff = root.join("dependency-diff.json")
execute("dependency-diff.shl", [dependencies_before, dependencies_after, dependency_diff])
let dependency_changes = json.parse(dependency_diff.read)
assert(dependency_changes.added.len() == 1 && dependency_changes.removed.len() == 1 && dependency_changes.updated.len() == 1, "dependency diff classification is wrong")

