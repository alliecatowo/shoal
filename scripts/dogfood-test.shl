execute("maintenance-window-plan.shl", [maintenance_tasks, "50", maintenance_plan])
assert(json.parse(maintenance_plan.read).deferred == ["optional"], "maintenance planner exceeded its window")

let components = root.join("components.json")
json.stringify([
  {name: "parser", owner: "language", status: "healthy"},
  {name: "release", owner: "operations", status: "degraded"},
  {name: "legacy", owner: "unowned", status: "healthy"},
], pretty: true).save(components)
