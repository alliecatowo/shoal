execute("incident-timeline.shl", [incident_events, incident_timeline])
assert(json.parse(incident_timeline.read).duration_ns == 20, "incident timeline duration is wrong")

let sensitive_logs = root.join("sensitive-logs.json")
let redaction_values = root.join("redaction-values.json")
json.stringify([{level: "error", message: "request used token-secrecy-value"}], pretty: true).save(sensitive_logs)
json.stringify([{name: "token", value: "secrecy-value"}], pretty: true).save(redaction_values)
