execute("change-risk-report.shl", [changes, risk_report])
assert(json.parse(risk_report.read).level == "high", "change risk report misclassified the release")

let expected_config = root.join("expected-config.json")
let actual_config = root.join("actual-config.json")
json.stringify([{key: "color", value: "blue"}, {key: "jobs", value: 4}], pretty: true).save(expected_config)
json.stringify([{key: "jobs", value: 8}, {key: "trace", value: true}], pretty: true).save(actual_config)
let config_drift = root.join("config-drift.json")
execute("config-drift.shl", [expected_config, actual_config, config_drift])
let drift = json.parse(config_drift.read)
assert(drift.missing.len() == 1 && drift.unexpected.len() == 1 && drift.changed.len() == 1, "configuration drift classification is wrong")

