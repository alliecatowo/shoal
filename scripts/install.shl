#!/usr/bin/env shoal
# Invoke the fd-relative crash-recovery engine shipped beside this Shoal program.

let options = args.map(.str())
let supported = ["--clean", "--check", "--uninstall", "--force"]
let unknown = options.where(option => !(option in supported))
assert(unknown.is_empty(), "usage: install.shl [--clean|--check|--uninstall [--force]]")
assert(options.len() <= 2, "usage: install.shl [--clean|--check|--uninstall [--force]]")
assert(!options.contains("--force") || options.contains("--uninstall"), "--force requires --uninstall")

let release_dir = path((env SHOAL_RELEASE_DIR).out ?? "target/release")
let helper = release_dir.join("shoal-install-transaction")
assert(helper.is_file, "missing installer transaction helper: {helper}")

let result = if (options.is_empty()) {
  run(helper)
} else if (options.len() == 1) {
  run(helper, options.first())
} else {
  run(helper, options[0], options[1])
}
assert(result.ok, result.err.str().trim())
let message = result.out.str().trim()
echo message
