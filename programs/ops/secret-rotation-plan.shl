#!/usr/bin/env shoal
# Select credentials due for rotation from explicit age policy.

assert(args.len() == 3, "usage: secret-rotation-plan.shl CREDENTIALS MAX_AGE_DAYS OUTPUT")
let input = path(args[0].str())
let max_age = args[1].str().parse_int()
let output = path(args[2].str())
assert(input.is_file && max_age > 0, "credential input or age policy is invalid")
let credentials = json.parse(input.read)
let invalid = credentials.where(row => row.name == null || row.age_days < 0)
assert(invalid.is_empty(), "credential rows are invalid: {invalid}")
let rotate = credentials.where(row => row.age_days >= max_age || row.compromised)
  .map(row => ({name: row.name, reason: if (row.compromised) { "compromised" } else { "age" }, age_days: row.age_days}))
  .sort_by(row => -row.age_days)
let report = {max_age_days: max_age, rotate: rotate, current: credentials.len() - rotate.len(), requires_confirmation: !rotate.is_empty()}
json.stringify(report, pretty: true).save(output)
echo "secret rotation plan: {rotate.len()} due, {report.current} current"
